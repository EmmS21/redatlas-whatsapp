# Meta WhatsApp Cloud API (test number). developers.facebook.com → your app → WhatsApp → API Setup.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=

# RED Atlas session token (the ra_access value). The demo replies from captured
# data and does not call the API. Set this on Render so the session is available.
RED_ATLAS_TOKEN=

PORT=3000
